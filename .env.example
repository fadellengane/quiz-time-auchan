# Base de données PostgreSQL (ex: Vercel Postgres, Supabase, Neon, Railway...)
DATABASE_URL="postgresql://user:password@localhost:5432/quiz_time_auchan?schema=public"

# Authentification espace admin
JWT_SECRET="change-me-in-production-use-a-long-random-string"
ADMIN_EMAIL="admin@auchan.fr"
ADMIN_PASSWORD="change-me"

# Magasin par défaut (utilisé tant que le multi-magasin n'est pas activé)
DEFAULT_STORE_SLUG="auchan-demo"
